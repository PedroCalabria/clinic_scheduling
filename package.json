{
  "name": "clinic-scheduling",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:portal": "pnpm --filter @clinic/patient-portal dev",
