# Copy to .env and fill in. Never commit .env (see .gitignore).
# Every variable the Compose stack reads is listed here.

# --- PostgreSQL (db service) ---
POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me-locally

# --- API ---
# The API's connection string is NOT set here: docker-compose.yml composes it from the three
# POSTGRES_ values above, so those are the single place to change database credentials. A
# ConnectionStrings__Default line in this file would be ignored, which is worse than absent.
ASPNETCORE_ENVIRONMENT=Development

# --- Clinic (Decision H) ------------------------------------------------------
# The clinic's timezone, as an IANA zone id. REQUIRED: the API refuses to start
# without it rather than guessing, because a wrong zone records working hours
# correctly and interprets them an hour out (design E3, professional-configuration).
Clinic__Timezone=America/Sao_Paulo

# Provisions a demo clinic (specialties, rooms, appointment types, and one configured
# professional) on startup. Development only — it does nothing in any other environment,
# whatever this says. Off by default; turn it on for a machine you want a runnable demo on.
Clinic__SeedDevelopmentData=false

# --- Scheduling policy (availability-read) ---
# All four have code defaults, deliberately unlike Clinic__Timezone above: a 15-minute
# slot step is right until a clinic says otherwise, while a timezone default is wrong for
# every clinic but one. Leave them out unless you mean to change them.
#
# How far apart offered slot starts are placed. Independent of appointment length, so
# consecutive candidate slots overlap — the patient picks a convenient time.
# Scheduling__SlotStartStepMinutes=15
# How soon from now a slot may start. 0 permits immediate booking.
# Scheduling__MinimumLeadTimeMinutes=60
# How far ahead the clinic accepts bookings.
# Scheduling__HorizonDays=60
# Widest window one availability request may ask for; more is refused, never truncated.
# Scheduling__MaxWindowDays=31
# Availability requests permitted per caller per minute (03-nfr.md §2).
# Scheduling__AvailabilityRequestsPerMinute=60
# How much notice a patient must give to cancel or reschedule (F3). Not a solver input: it
# governs who may undo, never what is offered. Lower it to make the locked state reachable by hand.
# Scheduling__CancellationCutoffHours=24

# --- Caddy ---
# Local: ":80" serves plain HTTP (Let's Encrypt cannot issue for localhost — design D9).
# Production: set to the public hostname (e.g. clinic.example.com) and Caddy
# engages automatic HTTPS from the same Caddyfile. Config difference, not a code one.
CADDY_SITE_ADDRESS=:80

# Host port mapped to Caddy's port 80. Caddy is the only service that publishes a port.
CADDY_HTTP_PORT=8080

# --- Identity & session (change 2: identity-session) ---
# How long a session stays valid from the moment it is issued. Fixed absolute lifetime;
# there is no sliding renewal (design A1).
Auth__SessionLifetime=08:00:00

# Consecutive failed sign-ins that lock an account, and login attempts allowed per client
# address per minute. Two independent brakes: one account tried from many places, and many
# accounts tried from one place (design A10).
Auth__LockoutThreshold=5
Auth__LoginAttemptsPerMinute=10

# Shortest password an internal account may set. Length only - composition rules push
# people towards predictable substitutions.
Auth__MinimumPasswordLength=12

# Version recorded on consents granted from now on.
Auth__ConsentVersion=2026-08

# --- First administrator (CREDENTIALS, not settings) ---
# S11 is how staff accounts are created, and only an administrator may open it. These two
# values are the way in. The account they create MUST change this password on first
# sign-in, and the API refuses everything else until it does (design A6).
# Leave both empty on a deployment whose administrator already exists.
Auth__BootstrapAdministrator__Email=admin@clinic.local
Auth__BootstrapAdministrator__Password=change-me-on-first-sign-in

# --- Google OIDC (OPTIONAL: absent means the federated path is off) ---
# Create the OAuth client in the Google Cloud Console and register the redirect URI below
# EXACTLY as written. Google permits plain HTTP for localhost, so local development needs
# no tunnel (that is change 7's problem, for webhooks).
# Without these the app still starts and internal accounts still sign in; only the Google
# button reports auth.google_unavailable (design A14).
Auth__Google__ClientId=
Auth__Google__ClientSecret=
Auth__Google__RedirectUri=http://localhost:8080/api/auth/google/callback

# --- Google Calendar connection (OPTIONAL: absent means S2 reports the feature is off) ---
# Change 6a. This is a SECOND permission from the SAME OAuth client above: a professional
# grants calendar access from /staff/calendar, separately from signing in. Two manual steps
# in the Google Cloud Console are required before it works (docs/08-google-setup.md):
#   1. register the redirect URI below, EXACTLY as written — it is a second URI, not a
#      replacement for the sign-in one;
#   2. enable the Google Calendar API on the project.
#
# Setting Calendar__RedirectUri is what turns the feature on. Leave it empty and the app
# starts exactly as before; set it WITHOUT a token-encryption key and the API refuses to
# start, because a refresh token is a long-lived credential and is never stored in clear.
Calendar__RedirectUri=

# The key that encrypts a professional's refresh token at rest (design K3). Generate one:
#
#   openssl rand -base64 32
#
# THIS VALUE MUST SURVIVE REDEPLOYS. It is not a setting; it is the only thing that can read
# the stored credentials. Losing or changing it corrupts nothing, but every stored token
# becomes unreadable and every professional has to reconnect their calendar. Keep it in .env
# (git-ignored) or Docker secrets — never in the repository (03-nfr.md §2).
Calendar__TokenEncryptionKey=
