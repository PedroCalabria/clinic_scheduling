# Copy to .env and fill in. Never commit .env (see .gitignore).
# Every variable the Compose stack reads is listed here.

# --- PostgreSQL (db service) ---
POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me-locally

# --- API ---
# Host/port refer to the internal Compose network; db is not published to the host.
ConnectionStrings__Default=Host=db;Port=5432;Database=clinic;Username=clinic;Password=change-me-locally
ASPNETCORE_ENVIRONMENT=Development

# --- Caddy ---
# Local: ":80" serves plain HTTP (Let's Encrypt cannot issue for localhost — design D9).
# Production: set to the public hostname (e.g. clinic.example.com) and Caddy
# engages automatic HTTPS from the same Caddyfile. Config difference, not a code one.
CADDY_SITE_ADDRESS=:80

# Host port mapped to Caddy's port 80. Caddy is the only service that publishes a port.
CADDY_HTTP_PORT=8080
