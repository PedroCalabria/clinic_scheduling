# Copy to .env and fill in. Never commit .env (see .gitignore).
# Every variable the Compose stack reads is listed here.

# --- PostgreSQL (db service) ---
POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me-locally

# --- API ---
# The API's connection string is NOT set here: docker-compose.yml composes it from the three
# POSTGRES_ values above, so those are the single place to change database credentials. A
# ConnectionStrings__Default line in this file would be ignored, which is worse than absent.
ASPNETCORE_ENVIRONMENT=Development

# --- Caddy ---
# Local: ":80" serves plain HTTP (Let's Encrypt cannot issue for localhost — design D9).
# Production: set to the public hostname (e.g. clinic.example.com) and Caddy
# engages automatic HTTPS from the same Caddyfile. Config difference, not a code one.
CADDY_SITE_ADDRESS=:80

# Host port mapped to Caddy's port 80. Caddy is the only service that publishes a port.
CADDY_HTTP_PORT=8080

# --- Identity & session (change 2: identity-session) ---
# How long a session stays valid from the moment it is issued. Fixed absolute lifetime;
# there is no sliding renewal (design A1).
Auth__SessionLifetime=08:00:00

# Consecutive failed sign-ins that lock an account, and login attempts allowed per client
# address per minute. Two independent brakes: one account tried from many places, and many
# accounts tried from one place (design A10).
Auth__LockoutThreshold=5
Auth__LoginAttemptsPerMinute=10

# Shortest password an internal account may set. Length only - composition rules push
# people towards predictable substitutions.
Auth__MinimumPasswordLength=12

# Version recorded on consents granted from now on.
Auth__ConsentVersion=2026-08

# --- First administrator (CREDENTIALS, not settings) ---
# S11 is how staff accounts are created, and only an administrator may open it. These two
# values are the way in. The account they create MUST change this password on first
# sign-in, and the API refuses everything else until it does (design A6).
# Leave both empty on a deployment whose administrator already exists.
Auth__BootstrapAdministrator__Email=admin@clinic.local
Auth__BootstrapAdministrator__Password=change-me-on-first-sign-in

# --- Google OIDC (OPTIONAL: absent means the federated path is off) ---
# Create the OAuth client in the Google Cloud Console and register the redirect URI below
# EXACTLY as written. Google permits plain HTTP for localhost, so local development needs
# no tunnel (that is change 7's problem, for webhooks).
# Without these the app still starts and internal accounts still sign in; only the Google
# button reports auth.google_unavailable (design A14).
Auth__Google__ClientId=
Auth__Google__ClientSecret=
Auth__Google__RedirectUri=http://localhost:8080/api/auth/google/callback
