<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Clinic.Api</RootNamespace>
    <AssemblyName>Clinic.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Decision L's second data-access technology, and it belongs to THIS project only. Domain
      references no infrastructure, and Domain.csproj's ForbidInfrastructureReferences target
      plus DomainBoundaryTests would both fail if this line were added there instead — which is
      the likelier mistake, since the booking rules it serves live in Domain.
    -->
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageReference Include="NodaTime" Version="3.3.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <!-- The integration test project drives the app through WebApplicationFactory. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Clinic.Api.IntegrationTests" />
  </ItemGroup>

</Project>
